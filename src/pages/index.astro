---
import Header from "../components/Header.astro";
---

<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CALIPRO | מאסטריות במשקל גוף</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@300;400;700;800&display=swap" rel="stylesheet">

    <style>
      :root {
        --primary: #ff5f00;
        --dark: #121212;
        --light: #f4f4f4;
        --gray: #2a2a2a;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Assistant', sans-serif;
        background: var(--dark);
        color: var(--light);
        line-height: 1.6;
        overflow-x: hidden;
      }

      .container {
        width: min(1200px, 90%);
        margin: auto;
      }

      section {
        padding: 6rem 0;
      }

      h2 {
        font-size: 3rem;
        margin-bottom: 3rem;
        text-align: center;
        text-transform: uppercase;
        font-weight: 800;
      }

      h2 span {
        color: var(--primary);
      }

      /* About Section */
      .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: center;
      }

      .about-image {
        position: relative;
      }

      .about-image img {
        width: 100%;
        border-radius: 20px;
        box-shadow: 20px 20px 0 var(--primary);
      }

      .about-text p {
        font-size: 1.2rem;
        margin-bottom: 1.5rem;
      }

      /* Skills Section */
      .skills-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
      }

      .skill-card {
        background: var(--gray);
        padding: 3rem 2rem;
        border-radius: 15px;
        text-align: center;
        transition: transform 0.3s;
        border-bottom: 4px solid transparent;
      }

      .skill-card:hover {
        transform: translateY(-10px);
        border-bottom-color: var(--primary);
      }

      .skill-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        display: block;
      }

      .skill-card h3 {
        font-size: 1.8rem;
        margin-bottom: 1rem;
        color: var(--primary);
      }

      /* Training Section */
      .training-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 2rem;
      }

      .program {
        position: relative;
        overflow: hidden;
        border-radius: 20px;
        height: 400px;
      }

      .program img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s;
      }

      .program:hover img {
        transform: scale(1.1);
      }

      .program-content {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        padding: 2rem;
        background: linear-gradient(transparent, rgba(0,0,0,0.9));
      }

      /* Contact Form */
      .contact-box {
        background: var(--gray);
        padding: 4rem;
        border-radius: 30px;
        max-width: 800px;
        margin: auto;
      }

      .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
      }

      input, textarea {
        width: 100%;
        padding: 1.2rem;
        background: #1a1a1a;
        border: 1px solid #333;
        color: white;
        border-radius: 10px;
        font-size: 1rem;
      }

      textarea {
        grid-column: span 2;
      }

      .submit-btn {
        grid-column: span 2;
        background: var(--primary);
        color: white;
        border: none;
        padding: 1.2rem;
        border-radius: 10px;
        font-weight: 800;
        font-size: 1.2rem;
        cursor: pointer;
        transition: 0.3s;
      }

      .submit-btn:hover {
        background: #e65600;
        letter-spacing: 2px;
      }

      footer {
        text-align: center;
        padding: 3rem;
        background: #0a0a0a;
        opacity: 0.7;
      }

      @media (max-width: 768px) {
        .about-grid { grid-template-columns: 1fr; }
        .form-grid { grid-template-columns: 1fr; }
        textarea { grid-column: span 1; }
        .submit-btn { grid-column: span 1; }
      }
    </style>
  </head>

  <body>
    <Header />

    <main>
      <!-- About -->
      <section id="about" class="container">
        <div class="about-grid">
          <div class="about-image">
            <img src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80" alt="Training" />
          </div>
          <div class="about-text">
            <h2>מי <span>אני?</span></h2>
            <p>אני דורון, אתלט קליסטניקס המתמחה בתנועה, כוח ושליטה אבסולוטית במשקל הגוף.</p>
            <p>המסע שלי התחיל מהרצון להיות חזק יותר, אבל גיליתי שהקליסטניקס הוא הרבה יותר מזה - הוא שילוב של אמנות, משמעת עצמית ויכולת לפרוץ את הגבולות הפיזיים והמנטליים כל יום מחדש.</p>
            <p>אני כאן כדי לעזור לכם להשיג את ה-Muscle-up הראשון שלכם, לעמוד על הידיים, או פשוט לבנות גוף חזק ובריא יותר.</p>
          </div>
        </div>
      </section>

      <!-- Skills -->
      <section id="skills" style="background: #0a0a0a;">
        <div class="container">
          <h2>התמחות <span>מקצועית</span></h2>
          <div class="skills-grid">
            <div class="skill-card">
              <span class="skill-icon">🤸‍♂️</span>
              <h3>עמידות ידיים</h3>
              <p>שיווי משקל ושליטה בסיסית ומתקדמת במנח הפוך.</p>
            </div>
            <div class="skill-card">
              <span class="skill-icon">💪</span>
              <h3>אלמנטים סטטיים</h3>
              <p>Planche, Front Lever ו-Human Flag. כוח טהור.</p>
            </div>
            <div class="skill-card">
              <span class="skill-icon">🔥</span>
              <h3>כוח מתפרץ</h3>
              <p>Muscle-ups, שכיבות סמיכה בזינוק ותנועה דינמית.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Training -->
      <section id="training" class="container">
        <h2>תוכניות <span>אימון</span></h2>
        <div class="training-cards">
          <div class="program">
            <img src="https://images.unsplash.com/photo-1544033527-b192daee1f5b?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80" alt="Basics" />
            <div class="program-content">
              <h3>יסודות הקליסטניקס</h3>
              <p>מיועד למתחילים שרוצים לבנות בסיס חזק.</p>
            </div>
          </div>
          <div class="program">
            <img src="https://images.unsplash.com/photo-1526506118085-60ce8714f8c5?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80" alt="Elite" />
            <div class="program-content">
              <h3>מסלול אליט</h3>
              <p>תוכנית אינטנסיבית לאלמנטים מתקדמים.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Contact -->
      <section id="contact" style="background: #0a0a0a;">
        <div class="container">
          <h2>מוכנים <span>להתחיל?</span></h2>
          <div class="contact-box">
            <form>
              <div class="form-grid">
                <input type="text" placeholder="שם מלא" required />
                <input type="email" placeholder="אימייל" required />
                <textarea rows="5" placeholder="ספרו לי על המטרות שלכם..."></textarea>
                <button type="submit" class="submit-btn">שלח הודעה</button>
              </div>
            </form>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <p>&copy; 2026 CALIPRO. כל הזכויות שמורות. נבנה באהבה עם Astro.</p>
    </footer>
  </body>
</html>
